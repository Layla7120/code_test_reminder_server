# ── DB 연결 ─────────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database_name

# [Local] TCP 연결 시 host:port 형식
DB_HOST=127.0.0.1
DB_PORT=3306

# [Deploy] GCP Cloud SQL Unix 소켓 경로
# DB_HOST=/cloudsql/project-id:region:instance-name

# ── GitHub API ───────────────────────────────────────────────
# https://github.com/settings/tokens 에서 발급
# 필요 권한: repo (public_repo)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── 서버 포트 ────────────────────────────────────────────────
PORT=8080

# ── SQLAlchemy 커넥션 풀 (선택) ──────────────────────────────
# 기본값: POOL_SIZE=5, MAX_OVERFLOW=10 (최대 15개 커넥션)
# 부하 테스트 튜닝 시 조정
# SQLALCHEMY_POOL_SIZE=10
# SQLALCHEMY_MAX_OVERFLOW=20
